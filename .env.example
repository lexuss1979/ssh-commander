# Пароль для входа в веб-интерфейс.
# При первом запуске (чистый data/) его можно задать прямо в интерфейсе —
# onboarding спросит пароль (и опционально ключ AI) до первого входа, пароль
# сохранится хешем в data/settings.json. env — фолбэк для существующих
# развёртываний и headless-запуска; дефолт 'admin' при этом остаётся.
APP_PASSWORD=change-me

# OpenAI-совместимый API (OpenAI, OpenRouter, vLLM и т.п.).
# Ключ и base URL можно задать при первом старте в интерфейсе (onboarding):
# они сохраняются в data/settings.json и приоритетнее этих переменных.
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_STEPS=30
AI_TEMPERATURE=0.2

# Язык системного промпта и ответов AI-агента: ru (по умолчанию) или en.
# Неизвестные значения сводятся к ru.
AI_LANG=ru

# Веб-поиск для AI-агента: Anthropic-совместимый endpoint DeepSeek с серверным
# инструментом web_search (использует тот же ключ — из AI_API_KEY или заданный
# в onboarding). Пусто — поиск выключен, инструмент агенту не объявляется.
# База и модель поиска — только env (в onboarding не задаются).
AI_SEARCH_API_BASE=
AI_SEARCH_MODEL=deepseek-v4-flash
