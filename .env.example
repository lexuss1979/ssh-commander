# Пароль для входа в веб-интерфейс (обязательно смените)
APP_PASSWORD=change-me

# OpenAI-совместимый API (OpenAI, OpenRouter, vLLM и т.п.)
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_STEPS=30
AI_TEMPERATURE=0.2

# Веб-поиск для AI-агента: Anthropic-совместимый endpoint DeepSeek с серверным
# инструментом web_search (использует тот же AI_API_KEY). Пусто — поиск выключен,
# инструмент агенту не объявляется.
AI_SEARCH_API_BASE=
AI_SEARCH_MODEL=deepseek-v4-flash
