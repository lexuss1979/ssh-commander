# Пароль для входа в веб-интерфейс.
# Используется один раз при первом старте (seed): копируется хешем в
# data/settings.json. Дальше env не читается никогда — пароль меняется
# правкой data/settings.json (нужен рестарт); изменение переменной после
# первого старта ни на что не влияет.
APP_PASSWORD=change-me

# OpenAI-совместимый API (DeepSeek, OpenAI, OpenRouter, vLLM и т.п.).
# Используются один раз при первом старте (seed): копируются в
# data/settings.json (base определяет пресет провайдера). Дальше env не
# читается — AI-конфиг меняется правкой data/settings.json (нужен рестарт).
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_MAX_STEPS=30
AI_TEMPERATURE=0.2

# Язык агента отдельной настройкой не задаётся: он следует за переключателем
# языка интерфейса (localStorage sc-lang) и передаётся параметром WS-подключения.

# Веб-поиск для AI-агента. У пресета DeepSeek (в onboarding/настройках)
# поиск включён автоматически — тот же ключ, отдельная настройка не нужна.
# Для остальных провайдеров: Anthropic-совместимый endpoint с серверным
# инструментом web_search (например, https://api.deepseek.com/anthropic),
# env-only. Пусто и не DeepSeek — поиск выключен, инструмент агенту не
# объявляется.
AI_SEARCH_API_BASE=
AI_SEARCH_MODEL=deepseek-v4-flash
